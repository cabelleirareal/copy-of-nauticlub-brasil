// SPEC: SAAS_TRANSFORMATION_PLAN.md - Database Model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============= ENUMS =============

enum Role {
  OWNER
  BROKER
  BUYER
  ADMIN
}

enum Tier {
  FREE
  PRO
  AGENCY
}

enum BoatType {
  YACHT
  CRUISER
  SPORT
  JET_SKI
  LANCHA
  SAILBOAT
}

enum BoatStatus {
  AVAILABLE
  RESERVED
  SOLD
  PAUSED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISIT
  PROPOSAL
  WON
  LOST
}

enum LeadType {
  INTEREST
  SELL
  INSPECTION
  SHIPYARD
}

enum LeadSource {
  ORGANIC
  LISTING_BROKER
  PARTNER_BROKER
  ADS
  WHATSAPP
}

enum PartnershipStatus {
  PENDING
  APPROVED
  ACTIVE
  REVOKED
  EXPIRED
  COMPLETED
}

enum DealStatus {
  NEGOTIATING
  CONTRACT
  SIGNED
  PAID
  COMPLETED
  CANCELLED
}

enum SplitRole {
  LISTING_BROKER
  PARTNER_BROKER
  PLATFORM
  OWNER_REFERRAL
}

enum MediaType {
  IMAGE
  VIDEO
  DOC
  TOUR_360
}

// ============= MODELS =============

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  password        String
  name            String
  phone           String?
  role            Role
  avatar          String?
  brokerProfile   BrokerProfile?
  ownedBoats      Boat[]         @relation("OwnedBy")
  listedBoats     Boat[]         @relation("ListedBy")
  leadsAsBuyer    Lead[]         @relation("BuyerLeads")
  partnerships    Partnership[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([email])
  @@index([role])
}

model BrokerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cnpj             String?
  licenseNumber    String?
  bio              String?
  cityRegion       String?
  rating           Float    @default(0)
  totalDeals       Int      @default(0)
  subscriptionTier Tier     @default(FREE)
  stripeAccountId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Boat {
  id                 String        @id @default(uuid())
  name               String
  brand              String
  year               Int
  size               Float
  price              Decimal       @db.Decimal(12, 2)
  type               BoatType
  status             BoatStatus    @default(AVAILABLE)
  description        String?
  specs              Json
  location           String?
  marina             String?
  ownerId            String
  owner              User          @relation("OwnedBy", fields: [ownerId], references: [id])
  listingBrokerId    String?
  listingBroker      User?         @relation("ListedBy", fields: [listingBrokerId], references: [id])
  openToPartnerships Boolean       @default(false)
  defaultCommission  Decimal       @default(5.0) @db.Decimal(5, 2)
  defaultSplit       Json?
  featured           Boolean       @default(false)
  views              Int           @default(0)
  media              BoatMedia[]
  leads              Lead[]
  partnerships       Partnership[]
  deals              Deal[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([type])
  @@index([status])
  @@index([listingBrokerId])
}

model BoatMedia {
  id        String    @id @default(uuid())
  boatId    String
  boat      Boat      @relation(fields: [boatId], references: [id], onDelete: Cascade)
  url       String
  type      MediaType
  order     Int       @default(0)
  isCover   Boolean   @default(false)
  watermark Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Lead {
  id               String     @id @default(uuid())
  boatId           String?
  boat             Boat?      @relation(fields: [boatId], references: [id])
  name             String
  email            String
  phone            String
  message          String?
  buyerId          String?
  buyer            User?      @relation("BuyerLeads", fields: [buyerId], references: [id])
  assignedBrokerId String?
  source           LeadSource @default(ORGANIC)
  status           LeadStatus @default(NEW)
  type             LeadType   @default(INTEREST)
  notes            Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status])
  @@index([assignedBrokerId])
  @@index([boatId])
}

model Partnership {
  id              String            @id @default(uuid())
  boatId          String
  boat            Boat              @relation(fields: [boatId], references: [id])
  partnerBrokerId String
  partnerBroker   User              @relation(fields: [partnerBrokerId], references: [id])
  listingBrokerId String
  status          PartnershipStatus @default(PENDING)
  terms           Json
  contractUrl     String?
  signedAt        DateTime?
  expiresAt       DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([boatId])
  @@index([partnerBrokerId])
}

model Deal {
  id              String            @id @default(uuid())
  boatId          String
  boat            Boat              @relation(fields: [boatId], references: [id])
  leadId          String?
  buyerId         String?
  agreedPrice     Decimal           @db.Decimal(12, 2)
  commissionTotal Decimal           @db.Decimal(12, 2)
  splits          CommissionSplit[]
  status          DealStatus        @default(NEGOTIATING)
  contractUrl     String?
  closedAt        DateTime?
  paidAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([boatId])
}

model CommissionSplit {
  id               String    @id @default(uuid())
  dealId           String
  deal             Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  recipientUserId  String?
  role             SplitRole
  percent          Decimal   @db.Decimal(5, 2)
  amount           Decimal   @db.Decimal(12, 2)
  paidOut          Boolean   @default(false)
  stripeTransferId String?
  createdAt        DateTime  @default(now())
}
